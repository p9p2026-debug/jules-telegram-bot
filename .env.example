# ====================================================================
# Jules Telegram Bot - Environment Variables Template
# Copy this file to .env and fill in your confidential keys.
# ====================================================================

# 1. Telegram Bot Token (Obtained from @BotFather on Telegram)
# Required
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# 2. Superadmin Telegram User IDs (Comma-separated numbers)
# Required - users with full control over /admin dashboard
# You can obtain your User ID from bots like @userinfobot
ADMIN_IDS=123456789,987654321

# 3. Google Gemini / Jules Agent API Key
# Required - Get it from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyD-ExampleKeyHere1234567890abcdef

# 4. Model Selection (Configurable identifiers)
# Default for Pro is gemini-2.5-pro or gemini-3.1-pro-preview
MODEL_PRO_ID=gemini-2.5-pro
MODEL_FLASH_ID=gemini-2.5-flash

# UI Display Names
MODEL_PRO_NAME=Gemini 3.1 Pro (Jules Core)
MODEL_FLASH_NAME=Gemini 3.6 Flash (Fast Agent)

# 5. Database Path
# Default stores locally in data/jules_bot.db
# For Render Persistent Disk, use /var/data/jules_bot.db
DATABASE_PATH=data/jules_bot.db

# 6. Web Server Settings (Render assigns PORT automatically)
PORT=8080
HOST=0.0.0.0
